{
  "openapi": "3.1.0",
  "info": {
    "title": "edgy API",
    "version": "0.0.0",
    "description": "Every response is an envelope: `{ status, data | error, metadata, links? }`. Lists are paged by cursor. The API is unauthenticated and rate limited per client."
  },
  "paths": {
    "/api/users": {
      "get": {
        "operationId": "getApiUsers",
        "summary": "List users, a page at a time",
        "tags": [
          "users"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Items per page: an integer from 1 to 100. Default 20.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Where the next page starts. Copy `next_cursor` from the previous page; it belongs to the sort it was issued for.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "description": "Column to sort by. Default `id`.",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "email",
                "name"
              ]
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "description": "Sort direction. Default `asc`.",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "data",
                    "metadata"
                  ],
                  "properties": {
                    "status": {
                      "const": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string",
                            "maxLength": 254,
                            "description": "Stored in lowercase; the same address in another spelling is a conflict."
                          },
                          "name": {
                            "type": "string",
                            "maxLength": 200,
                            "description": "Display name; not blank."
                          }
                        },
                        "required": [
                          "id",
                          "email",
                          "name"
                        ]
                      }
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/ApiPageMetadata"
                    },
                    "links": {
                      "$ref": "#/components/schemas/ApiLinks"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error, in the error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postApiUsers",
        "summary": "Create a user",
        "tags": [
          "users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "description": "Stored in lowercase; the same address in another spelling is a conflict."
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Display name; not blank."
                  }
                },
                "required": [
                  "email",
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "data",
                    "metadata"
                  ],
                  "properties": {
                    "status": {
                      "const": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "maxLength": 254,
                          "description": "Stored in lowercase; the same address in another spelling is a conflict."
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "Display name; not blank."
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "name"
                      ]
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/ApiMetadata"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error, in the error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "operationId": "getApiUsersId",
        "summary": "Get one user by id",
        "tags": [
          "users"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "data",
                    "metadata"
                  ],
                  "properties": {
                    "status": {
                      "const": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "maxLength": 254,
                          "description": "Stored in lowercase; the same address in another spelling is a conflict."
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 200,
                          "description": "Display name; not blank."
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "name"
                      ]
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/ApiMetadata"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error, in the error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiLinks": {
        "type": "object",
        "description": "Relative links by relation; `null` where there is none.",
        "additionalProperties": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "ApiMetadata": {
        "type": "object",
        "required": [
          "status_code",
          "request_id"
        ],
        "properties": {
          "status_code": {
            "type": "integer"
          },
          "request_id": {
            "type": "string",
            "description": "The `req_` id, also in the `x-request-id` header."
          },
          "trace_id": {
            "type": "string",
            "description": "Set when the request was traced."
          },
          "cache": {
            "enum": [
              "hit",
              "miss",
              "bypass"
            ],
            "description": "Set when a cached read answered."
          },
          "rate_limit": {
            "type": "object",
            "required": [
              "limit",
              "reset"
            ],
            "properties": {
              "limit": {
                "type": "integer"
              },
              "remaining": {
                "type": "integer"
              },
              "reset": {
                "type": "integer",
                "description": "Unix time at which the window resets."
              }
            }
          }
        }
      },
      "ApiPageMetadata": {
        "description": "Metadata of a collection: the position in it.",
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiMetadata"
          },
          {
            "type": "object",
            "required": [
              "limit",
              "has_more",
              "next_cursor"
            ],
            "properties": {
              "limit": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              },
              "next_cursor": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Opaque. Pass it as `cursor` for the next page; `null` on the last."
              }
            }
          }
        ]
      },
      "ApiError": {
        "type": "object",
        "required": [
          "status",
          "message",
          "error",
          "metadata"
        ],
        "properties": {
          "status": {
            "const": "error"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable; clients switch on it (`NOT_FOUND`)."
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "description": "Per-error facts, such as the validation issues."
              }
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/ApiMetadata"
          }
        }
      }
    }
  }
}
