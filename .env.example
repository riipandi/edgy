# Generated by `pnpm app config:generate`; do not edit by hand.
# Every variable below is optional: the value shown is the default.
# Copy this file to `.env` and change only what you need.

# --- Server ---
# Interface the HTTP server binds to; 0.0.0.0 exposes it on every interface (containers) (string)
HOST=127.0.0.1

# Port the HTTP server listens on (port)
PORT=3000

# Largest accepted request body, in bytes (413 above) (integer)
BODY_LIMIT=1048576

# A request running longer than this is interrupted and answered with 504 (milliseconds)
REQUEST_TIMEOUT=30000

# How long a graceful shutdown waits for in-flight requests before closing them (milliseconds)
SHUTDOWN_TIMEOUT=10000

# Pause between /health turning 503 and the server closing, so a load balancer can drain first (milliseconds)
SHUTDOWN_DRAIN_DELAY=0

# Requests handled at once before new ones are refused with 503 (overload guard); 0 disables (integer)
MAX_IN_FLIGHT=1024

# Proxies that may set the client address in X-Forwarded-For / X-Real-IP: false (none), true (every address; only when the app is unreachable except through your proxy), or a comma-separated list of IP addresses and CIDR ranges (string)
TRUST_PROXY=false

# Header a CDN or platform sets to the client address, read directly instead of X-Forwarded-For (CF-Connecting-IP, Fly-Client-IP, X-Appengine-Remote-Addr, or your own proxy's); empty for none (string)
TRUSTED_PLATFORM=

# Load balancers that open each connection with a PROXY protocol header (v1 or v2) naming the real client: false (none), true (every peer; only when nothing but your balancer can connect), or a comma-separated list of IP addresses and CIDR ranges. A listed peer that sends no header is disconnected; any other peer is served as usual. Node.js only (string)
PROXY_PROTOCOL=false

# Read the client's country and city from CF-IPCountry / CF-IPCity and add them to the request log. Believed only when TRUSTED_PLATFORM is set, because anyone can send these headers to a server that Cloudflare does not front (boolean)
CLOUDFLARE_LOCATION_HEADERS=false

# --- Database ---
# Backend: node:sqlite on Node.js, or Cloudflare D1 (Workers, or local through wrangler) (enum: sqlite | d1)
DATABASE_DRIVER=sqlite

# SQLite file, or :memory: (driver sqlite only) (string)
DATABASE_PATH=./storage/data/edgy.db

# Name of the D1 binding in wrangler.jsonc (driver d1 only) (string)
D1_BINDING=DB

# Apply pending migrations when the app starts: on Workers (several isolates may race, prefer migrate:up once the schema exists) and in `pnpm dev`, where leaving it unset means on (boolean)
DATABASE_AUTO_MIGRATE=false

# --- Logging ---
# Minimum severity emitted (case-sensitive; Trace also prints SQL) (enum: All | Fatal | Error | Warn | Info | Debug | Trace | None)
LOG_LEVEL=Info

# Where logs go: any of console, file, otlp, comma-separated. otlp needs telemetry on (OTEL_SDK_DISABLED not true). Workers use the console and otlp only (list: console | file | otlp)
LOG_TRANSPORT=console,file

# Base path of the JSON-lines log; the file written carries the period, e.g. edgy_20261015.jsonl (string)
LOG_FILE=./storage/logs/edgy.jsonl

# How often a new log file starts (UTC): edgy_YYYYMMDD_hh, edgy_YYYYMMDD, edgy_YYYYMMDD (Monday), edgy_YYYYMM (enum: hourly | daily | weekly | monthly)
LOG_ROTATION=daily

# Log files kept, the current one included; older ones are deleted. 0 keeps every file (integer)
LOG_FILE_MAX_FILES=14

# Console format: human-readable lines, or one JSON object per line (the file is always JSON) (enum: pretty | json)
LOG_FORMAT=pretty

# How long log lines are buffered before one batched write to stdout (milliseconds)
LOG_FLUSH_INTERVAL=250

# --- Security ---
# Rate-limit the /api routes per client (boolean)
RATE_LIMIT_ENABLED=true

# Requests allowed per client per window on /api; with the cloudflare store only reported, so keep it equal to the limit in wrangler.jsonc (integer)
RATE_LIMIT_MAX=100

# Length of the rate-limit window (milliseconds)
RATE_LIMIT_WINDOW=60000

# Where counters live: per process (memory), shared by every instance (redis; Node.js only) or Cloudflare's rate-limit binding (cloudflare; Workers only, the real limit and period are set in wrangler.jsonc) (enum: memory | redis | cloudflare)
RATE_LIMIT_STORE=memory

# Name of the Workers rate-limit binding, used when RATE_LIMIT_STORE=cloudflare (string)
RATE_LIMIT_BINDING=RATE_LIMITER

# Redis or Valkey URL used when RATE_LIMIT_STORE or CACHE_STORE is redis; the default is the Valkey of `pnpm compose:up` (secret)
REDIS_URL=redis://:securedb@localhost:6379

# --- Cache ---
# Cache reads; off sends every read to the database (boolean)
CACHE_ENABLED=true

# Where cached entries live: per process (memory), shared by every instance (redis; Node.js only) or Cloudflare's Cache API (cloudflare; Workers only, per location, not served on workers.dev) (enum: memory | redis | cloudflare)
CACHE_STORE=memory

# How long an entry stays cached (milliseconds)
CACHE_TTL=30000

# With a shared store, how long a process also keeps its own copy (0 keeps none); bounds how stale another instance can be after a write (milliseconds)
CACHE_LOCAL_TTL=5000

# Entries a process keeps in memory, per cache; the oldest are dropped past it (integer)
CACHE_MAX_ENTRIES=256

# --- Observability ---
# Serve Prometheus metrics at GET /metrics (unauthenticated: expose only on a private network) (boolean)
METRICS_ENABLED=false

# Turn all telemetry export off (traces, metrics and otlp logs), whatever the endpoint (boolean)
OTEL_SDK_DISABLED=false

# OTLP/HTTP collector base URL; the default is the ClickStack of `pnpm compose:up` (string)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Headers sent with every export as key=value pairs separated by commas; the default is the development ingestion key of `pnpm compose:up` (secret)
OTEL_EXPORTER_OTLP_HEADERS=authorization=edgy-dev-ingestion-key

# Service name attached to every signal (string)
OTEL_SERVICE_NAME=edgy

# How often buffered traces, metrics and logs are sent (milliseconds)
OTEL_EXPORT_INTERVAL=5000

# Compression of export requests (enum: gzip | none)
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Fraction of requests whose trace is recorded (1 = all); a caller's sampled traceparent is always honoured (ratio 0-1)
OTEL_TRACES_SAMPLE_RATIO=0.7

# --- CORS ---
# Comma-separated allowed origins, or * for any (string)
CORS_ORIGINS=*

# Comma-separated allowed methods, or * for any (string)
CORS_METHODS=*

# Comma-separated allowed request headers, or * for any (string)
CORS_ALLOW_HEADERS=*

# Send access-control-allow-credentials (requires explicit CORS_ORIGINS) (boolean)
CORS_CREDENTIALS=false

# Preflight cache seconds; 0 or false omits the header (string)
CORS_MAX_AGE=86400
