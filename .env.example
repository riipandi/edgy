# Generated by `edgy generate:config`; do not edit by hand.
# Every variable below is optional: the value shown is the default.
# Copy this file to `.env` and change only what you need.

# Public origin of the application, used to resolve relative request URLs (string)
APP_BASE_URL=http://localhost:3000

# Runtime mode; production gates dev-only defaults (enum: development | test | production)
APP_MODE=development

# Expose the OpenAPI document and the Scalar API reference for the API (boolean)
APP_OPENAPI_ENABLED=false

# In-memory cache for feature lookups (boolean)
CACHE_ENABLED=true

# Maximum in-memory entries per cache (integer)
CACHE_MAX_ENTRIES=256

# Cache entry lifetime in milliseconds (milliseconds)
CACHE_TTL=30000

# Origins allowed to call the API cross-origin, comma-separated (empty allows any origin) (string)
CORS_ALLOWED_ORIGINS=

# Enable CORS for the API (boolean)
CORS_ENABLED=true

# Turso auth token, required for a remote database (secret)
DATABASE_TOKEN=

# Turso database URL: a file: URI for a local database, or a remote URL (string)
DATABASE_URL=file:./storage/data/app.db

# Base path for JSON-lines logs (string)
LOG_FILE=storage/logs/app.jsonl

# Maximum rotated log files; zero keeps all (integer)
LOG_FILE_MAX_FILES=14

# Buffered log flush interval (milliseconds)
LOG_FLUSH_INTERVAL=250

# Console log format (enum: pretty | json)
LOG_FORMAT=pretty

# Minimum log severity (enum: All | Fatal | Error | Warn | Info | Debug | Trace | None)
LOG_LEVEL=Info

# Log rotation period (enum: hourly | daily | weekly | monthly)
LOG_ROTATION=daily

# Log sinks (list: console | file | otlp)
LOG_TRANSPORT=console,file

# Expose Prometheus metrics at /metrics (boolean)
METRICS_ENABLED=false

# Telemetry export interval (milliseconds)
OTEL_EXPORT_INTERVAL=5000

# OTLP compression (enum: gzip | none)
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# OTLP/HTTP collector URL (string)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OTLP request headers (secret)
OTEL_EXPORTER_OTLP_HEADERS=authorization=edgy-dev-ingestion-key

# Disable trace and metric export (boolean)
OTEL_SDK_DISABLED=false

# Service name attached to telemetry (string)
OTEL_SERVICE_NAME=edgy

# Enable API rate limiting (boolean)
RATE_LIMIT_ENABLED=true

# Requests allowed per client per window (integer)
RATE_LIMIT_MAX=100

# Rate-limit window in milliseconds (milliseconds)
RATE_LIMIT_WINDOW=60000

# Use Redis for the configured rate-limit and cache stores (boolean)
REDIS_ENABLE=false

# Redis connection URL; each feature uses its own database index (secret)
REDIS_URL=redis://default:securedb@localhost:6379

# Interface the HTTP server binds to (string)
SERVER_HOST=0.0.0.0

# Port the HTTP server listens on (port)
SERVER_PORT=3000

# Proxies that may set X-Forwarded-For: true, false, or comma-separated IPs/CIDRs (string)
TRUST_PROXY=false
