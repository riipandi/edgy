import { input } from "../../../styles/components/input.css.ts";
import { email, list, muted, name, row } from "../../../styles/pages/user.css.ts";

export interface Input {
    users: Array<{ id: string; email: string; name: string }>;
}

<let/query="">
<const/needle=query.trim().toLowerCase()>
<const/shown=input.users.filter((user) => `${user.name} ${user.email}`.toLowerCase().includes(needle))>

<input type="search" class=input value:=query placeholder="Filter users" aria-label="Filter users">
<p class=muted>Showing ${shown.length} of ${input.users.length}</p>
<ul class=list>
    <for|user| of=shown by="id">
        <li class=row><span class=name>${user.name}</span><span class=email>${user.email}</span></li>
    </for>
</ul>
