import { detail, code, lead, status } from "../styles/messages.ts";
import { link } from "../styles/shell.ts";
import "../assets/global.css";

export interface Input {
    status: number;
    message: string;
    requestId?: string;
    retryAfter?: number;
}

<app-shell title=`${input.status} ${input.message}`>
    <p class=status>${input.status}</p>
    <p class=lead>${input.message}</p>
    <if=input.retryAfter>
        <p class=detail>Try again in ${input.retryAfter} seconds.</p>
    </if>
    <if=input.requestId>
        <p class=detail>Reference: <span class=code>${input.requestId}</span></p>
    </if>
    <p><a href="/" class=link>Back to the start</a></p>
</app-shell>
