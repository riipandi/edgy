{
    "name": "edgy",
    "version": "0.0.0",
    "private": "true",
    "license": "MIT",
    "bin": {
        "edgy": "./bin/edgy.mjs"
    },
    "type": "module",
    "main": "src/main.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "app": "node --env-file-if-exists=.env.local ./src/main.ts",
        "start": "node --env-file-if-exists=.env.local ./bin/edgy.mjs serve",
        "deploy": "pnpm -s build --mode worker --minify && wrangler deploy",
        "compile": "node ./builder/compile.ts --minify",
        "cleanup": "pnpm dlx del-cli dist .output .wrangler",
        "compose:cleanup": "docker compose down --remove-orphans --volumes && pnpm dlx del-cli .storage --force",
        "compose:up": "docker compose up --detach --remove-orphans",
        "compose:down": "docker compose down --remove-orphans",
        "compose:restart": "pnpm --silent run compose:down && pnpm --silent run compose:up",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "vendor:init": "git subtree add --prefix=vendor/effect https://github.com/Effect-TS/effect.git main --squash",
        "vendor:update": "git subtree pull --prefix=vendor/effect https://github.com/Effect-TS/effect.git main --squash",
        "prepare": "effect-tsgo patch --typescript --oxlint && panda codegen",
        "e2e:install": "playwright install --with-deps",
        "e2e:chrome": "playwright test --headed --project Chromium",
        "e2e:firefox": "playwright test --headed --project Firefox",
        "e2e:mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e:safari": "playwright test --headed --project Safari",
        "e2e:report": "playwright show-report .output/e2e-result",
        "e2e:ui": "playwright test --ui",
        "e2e": "playwright test",
        "test:report": "pnpm dlx node-http-server --root .output/tests-results --host 0.0.0.0 --port 8000 --spa --no-cache",
        "test:coverage": "vitest run --coverage",
        "test": "vitest --run",
        "check": "oxfmt --check && oxlint",
        "format": "oxfmt --write .",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@effect/platform-node": "4.0.5",
        "@solidjs/router": "2.0.0-next.40",
        "@solidjs/web": "2.0.0-rc.15",
        "effect": "^4.0.5",
        "h3": "^2.0.2",
        "kysely": "^0.29.6",
        "redis": "^6.3.0",
        "rou3": "1.0.0",
        "solid-js": "2.0.0-rc.15",
        "typeid-js": "^1.2.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.64.0",
        "@effect/tsgo": "0.53.1",
        "@effect/vitest": "^4.0.5",
        "@pandacss/dev": "^2.2.0",
        "@pandacss/preset-base": "2.2.0",
        "@pandacss/preset-panda": "2.2.0",
        "@pandacss/vite": "^2.2.0",
        "@playwright/test": "^1.64.1",
        "@solidjs/testing-library": "^0.8.10",
        "@solidjs/vite-plugin": "3.0.0-next.50",
        "@testing-library/jest-dom": "^7.0.1",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "filesystem-routing": "^0.4.0",
        "npm-check-updates": "^23.1.1",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "postject": "1.0.0-alpha.6",
        "typescript": "catalog:",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.22.0"
    }
}
