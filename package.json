{
    "name": "edgy",
    "version": "0.0.0",
    "private": "true",
    "license": "MIT",
    "bin": {
        "edgy": "./bin/edgy.mjs"
    },
    "type": "module",
    "main": "src/main.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "app": "node --env-file-if-exists=.env.local ./src/main.ts",
        "start": "node --env-file-if-exists=.env.local ./bin/edgy.mjs serve",
        "deploy": "pnpm -s build --mode worker --minify && wrangler deploy",
        "compile": "node ./builder/compile.ts --minify",
        "cleanup": "pnpm dlx del-cli dist .output .wrangler",
        "compose:cleanup": "docker compose down --remove-orphans --volumes && pnpm dlx del-cli .storage --force",
        "compose:up": "docker compose up --detach --remove-orphans",
        "compose:down": "docker compose down --remove-orphans",
        "compose:restart": "pnpm --silent run compose:down && pnpm --silent run compose:up",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "vendor:init": "git subtree add --prefix=vendor/effect https://github.com/Effect-TS/effect.git main --squash",
        "vendor:update": "git subtree pull --prefix=vendor/effect https://github.com/Effect-TS/effect.git main --squash",
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "e2e:install": "playwright install chromium --with-deps",
        "e2e:chrome": "E2E_BROWSER=chromium E2E_HEADED=1 vitest --run --project e2e",
        "e2e:firefox": "E2E_BROWSER=firefox E2E_HEADED=1 vitest --run --project e2e",
        "e2e:mobile": "E2E_BROWSER=mobile E2E_HEADED=1 vitest --run --project e2e",
        "e2e:safari": "E2E_BROWSER=webkit E2E_HEADED=1 vitest --run --project e2e",
        "e2e:all": "E2E_BROWSER=all vitest --run --project e2e",
        "e2e:ui": "E2E_HEADED=1 vitest --ui --project e2e",
        "e2e": "vitest --run --project e2e",
        "test:report": "pnpm dlx node-http-server --root .output/tests-results --host 0.0.0.0 --port 8000 --spa --no-cache",
        "test:coverage": "vitest run --coverage --project unit",
        "test": "vitest --run --project unit",
        "check": "oxfmt --check && oxlint",
        "format": "oxfmt --write .",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit && mtc"
    },
    "dependencies": {
        "@effect/platform-node": "4.0.5",
        "effect": "^4.0.5",
        "h3": "^2.0.2",
        "kysely": "^0.29.6",
        "marko": "^6.4.6",
        "redis": "^6.3.0",
        "typeid-js": "^1.2.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.64.0",
        "@effect/tsgo": "0.53.1",
        "@effect/vitest": "^4.0.5",
        "@marko/type-check": "^3.2.1",
        "@marko/vite": "^6.1.13",
        "@types/node": "^26.6.5",
        "@vanilla-extract/css": "^1.21.3",
        "@vanilla-extract/vite-plugin": "^5.2.6",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "npm-check-updates": "^23.1.1",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "playwright": "^1.64.1",
        "postject": "1.0.0-alpha.6",
        "typescript": "catalog:",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.22.0"
    }
}
