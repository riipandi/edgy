{
    "name": "edgy",
    "version": "0.0.0",
    "description": "Effect + h3 + Kysely HTTP server for Node.js and Cloudflare Workers",
    "keywords": [],
    "license": "MIT",
    "author": "",
    "bin": {
        "edgy": "./bin/edgy.mjs"
    },
    "type": "module",
    "main": "src/main.ts",
    "scripts": {
        "app": "node ./src/main.ts",
        "start": "node ./bin/edgy.mjs serve",
        "build": "node ./builder/cli.ts build",
        "compile": "node ./builder/cli.ts compile",
        "watch": "node --watch ./src/main.ts serve",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy",
        "cleanup": "pnpm dlx del-cli dist .output .wrangler",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "vendor:init": "git subtree add --prefix=vendor/effect https://github.com/Effect-TS/effect.git main --squash",
        "vendor:update": "git subtree pull --prefix=vendor/effect https://github.com/Effect-TS/effect.git main --squash",
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "test:watch": "vitest",
        "test": "vitest run",
        "check": "oxfmt --check && oxlint",
        "format": "oxfmt --write .",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@effect/platform-node": "4.0.5",
        "effect": "^4.0.5",
        "h3": "^2.0.2",
        "kysely": "^0.29.6",
        "typeid-js": "^1.2.0"
    },
    "devDependencies": {
        "@effect/tsgo": "0.53.1",
        "@types/node": "^26.6.5",
        "exsolve": "^1.1.3",
        "javascript-obfuscator": "^5.9.0",
        "npm-check-updates": "^23.1.1",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "postject": "1.0.0-alpha.6",
        "rolldown": "^1.2.14",
        "typescript": "catalog:",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.22.0"
    }
}
