{
    "name": "edgy",
    "version": "0.0.0",
    "description": "Node.js application blueprint with Effect, Kysely, and SolidJS",
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "preview": "vp preview",
        "app": "node --env-file-if-exists=.env.local src/main.ts",
        "start": "node --env-file-if-exists=.env.local dist/entry.js serve",
        "build:standalone": "vp build --mode standalone --minify",
        "docker:build": "docker build -f Dockerfile . --build-arg DISTROLESS_TAG=debug-nonroot -t $(node scripts/docker-ref.mjs -dev)",
        "docker:push": "docker push $(node scripts/docker-ref.mjs --image):latest-dev && docker push $(node scripts/docker-ref.mjs -dev)",
        "docker:run": "vpr dockerx --name $(node scripts/docker-ref.mjs --name) $(node scripts/docker-ref.mjs -dev)",
        "docker:shell": "vpr dockerx --entrypoint /busybox/sh $(node scripts/docker-ref.mjs -dev)",
        "docker:prune": "docker image rm --force $(docker image list --filter reference=$(node scripts/docker-ref.mjs --image):* -q)",
        "docker:images": "docker image list --filter reference=$(node scripts/docker-ref.mjs --image):*",
        "dockerx": "docker run --platform=linux/amd64 --network=host --rm -it -v ./storage:/app/storage:rw",
        "compose:cleanup": "docker compose down --remove-orphans --volumes && vpx del-cli .storage --force",
        "compose:up": "docker compose up --detach --remove-orphans",
        "compose:down": "docker compose down --remove-orphans",
        "compose:restart": "vpr compose:down && vpr compose:up",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build -o .output/storybook",
        "storybook:start": "vpx node-http-server --root .output/storybook --port 6006 --no-cache",
        "e2e:install": "playwright install --with-deps",
        "e2e:chrome": "playwright test --headed --project Chromium",
        "e2e:firefox": "playwright test --headed --project Firefox",
        "e2e:mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e:safari": "playwright test --headed --project Safari",
        "e2e:report": "playwright show-report .output/e2e-result",
        "e2e:ui": "playwright test --ui",
        "e2e": "playwright test",
        "coverage:report": "vpx node-http-server --root .output/coverage --port 8000 --spa --no-cache",
        "coverage": "vp test run --coverage --project=unit --project=integration",
        "test:storybook": "vp test --run --project=storybook",
        "test": "vp test --run",
        "check": "vp fmt --check && vp lint",
        "format": "vp fmt --write .",
        "lint": "vp lint --fix .",
        "typecheck": "tsc -b --noEmit",
        "prepare": "vp config"
    },
    "dependencies": {
        "@effect/platform-node": "4.0.6",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/mona-sans": "^5.3.0",
        "@solidjs/meta": "^1.0.0-next.2",
        "@solidjs/router": "^2.0.0-next.38",
        "@solidjs/web": "^2.0.0-rc.14",
        "@stylexjs/stylex": "^0.19.1",
        "effect": "^4.0.6",
        "kysely": "^0.29.7",
        "redis": "^6.3.0",
        "solid-js": "^2.0.0-rc.14",
        "typeid-js": "^1.2.0"
    },
    "devDependencies": {
        "@effect/vitest": "4.0.6",
        "@playwright/test": "^1.64.1",
        "@solidjs/vite-plugin": "^3.0.0-next.51",
        "@storybook/addon-docs": "^10.6.3",
        "@storybook/addon-vitest": "^10.6.3",
        "@stylexjs/unplugin": "^0.19.1",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "catalog:",
        "eslint-plugin-solid": "~0.18.1",
        "exsolve": "^1.1.3",
        "filesystem-routing": "0.4.1",
        "jsdom": "^30.1.3",
        "npm-check-updates": "^23.1.1",
        "storybook": "^10.6.3",
        "storybook-solidjs-vite": "^10.7.4",
        "typescript": "catalog:",
        "vite-plugin-devtools-json": "^1.1.2",
        "vite-plugin-solid": "^2.11.14",
        "vite-plus": "catalog:"
    },
    "config": {
        "image": "ghcr.io/riipandi/edgy"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.22.0"
    }
}
