{
    "name": "edgy",
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "app": "node --env-file-if-exists=.env.local src/main.ts",
        "start": "node --env-file-if-exists=.env.local dist/entry.js serve",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build -o .output/storybook",
        "storybook:start": "pnpm dlx node-http-server --root .output/storybook --port 6006 --no-cache",
        "e2e:install": "playwright install --with-deps",
        "e2e:chrome": "playwright test --headed --project Chromium",
        "e2e:firefox": "playwright test --headed --project Firefox",
        "e2e:mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e:safari": "playwright test --headed --project Safari",
        "e2e:report": "playwright show-report .output/e2e-result",
        "e2e:ui": "playwright test --ui",
        "e2e": "playwright test",
        "coverage:report": "pnpm dlx node-http-server --root .output/coverage --port 8000 --spa --no-cache",
        "coverage": "vitest run --coverage --project=unit",
        "test:storybook": "vitest --run --project=storybook",
        "test": "vitest --run",
        "check": "oxfmt --check && oxlint",
        "format": "oxfmt --write .",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@effect/platform-node": "4.0.5",
        "@solidjs/meta": "^1.0.0-next.2",
        "@solidjs/router": "^2.0.0-next.38",
        "@solidjs/web": "^2.0.0-rc.14",
        "@stylexjs/stylex": "^0.19.1",
        "effect": "^4.0.5",
        "kysely": "^0.29.7",
        "solid-js": "^2.0.0-rc.14",
        "typeid-js": "^1.2.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@solidjs/diagnostics": "^2.0.0-rc.14",
        "@solidjs/start-devtools": "^1.0.0-next.4",
        "@solidjs/testing-library": "^1.0.0-beta.3",
        "@solidjs/vite-plugin": "^3.0.0-next.50",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/addon-vitest": "^10.6.2",
        "@stylexjs/unplugin": "^0.19.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@types/node": "^26.6.5",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "eslint-plugin-solid": "~0.18.1",
        "exsolve": "^1.1.3",
        "filesystem-routing": "0.4.0",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "storybook": "^10.6.2",
        "storybook-solidjs-vite": "^10.7.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^5.0.5"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.22.0"
    }
}
