import { filter, muted, list, row } from "../styles/users.css.ts"

export interface Input {
  users: Array<{ id: string; email: string; name: string | null }>;
}

<let/query="">
<const/needle=query.trim().toLowerCase()>
<const/shown=input.users.filter((user) => `${user.name ?? ""} ${user.email}`.toLowerCase().includes(needle))>

<input type="search" class=filter value:=query placeholder="Filter users" aria-label="Filter users">
<p class=muted>Showing ${shown.length} of ${input.users.length}</p>
<ul class=list>
  <for|user| of=shown by="id">
    <li class=row>
      <strong>${user.name ?? "Unnamed"}</strong>
      <span class=muted>${user.email}</span>
    </li>
  </for>
</ul>
