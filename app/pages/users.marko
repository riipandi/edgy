export interface Input {
  users: Array<{ id: string; email: string; name: string }>;
  /** Rows after this page, in the order listed. */
  remaining: number;
}

<app-shell title="Users">
  <h1>Users</h1>
  <user-list users=input.users/>
  <if=(input.remaining > 0)>
    <p>${input.remaining} more not shown.</p>
  </if>
</app-shell>
