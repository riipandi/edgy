export interface Input {
  users: Array<{ id: string; email: string; name: string }>;
  total: number;
}

<app-shell title="Users">
  <h1>Users</h1>
  <user-list users=input.users/>
  <if=(input.total > input.users.length)>
    <p>${input.total - input.users.length} more not shown.</p>
  </if>
</app-shell>
