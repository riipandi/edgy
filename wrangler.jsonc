/**
 * Cloudflare Workers target, read by the Cloudflare Vite plugin under `--mode worker`. `pnpm dev`
 * runs the source in workerd with a local D1 database, `pnpm preview` runs the built artifact, and
 * `pnpm run deploy` publishes it. Application settings are the variables the Node server reads.
 *
 * The plugin writes the deployable configuration to `dist/worker/wrangler.json`. `assets` is added
 * from `dist/worker/public`, which Cloudflare serves without starting the Worker, so do not declare
 * `assets` or `no_bundle` here.
 *
 * Build: `pnpm build --mode worker`. Deploy: `pnpm exec wrangler deploy`.
 *
 * Variables that matter on Workers:
 * - OTEL_SDK_DISABLED: Off targets the local ClickStack, which a deployed Worker cannot reach. To
 *   export, set OTEL_EXPORTER_OTLP_ENDPOINT and OTEL_EXPORTER_OTLP_HEADERS (a secret) and remove
 *   this line.
 * - TRUSTED_PLATFORM: Cloudflare always sets CF-Connecting-IP, and the Worker is reachable only
 *   through Cloudflare, so that header is the client address.
 * - DATABASE_AUTO_MIGRATE: each isolate migrates on start, so a new D1 needs no separate step.
 *   Isolates starting together can race on the first migration. For production, migrate first with
 *   `pnpm app migrate:up --remote` and deploy with `--var DATABASE_AUTO_MIGRATE:false`.
 * - CACHE_STORE: the Workers Cache API is per location and is not served on workers.dev, where
 *   every read reaches D1. Use a custom domain.
 * - Rate limiting for /api: the allowance and period are fixed in the `ratelimits` binding.
 *   RATE_LIMIT_MAX is reported to clients, so keep it equal to `limit`. RATE_LIMIT_WINDOW feeds
 *   Retry-After, so keep it equal to `period` in ms.
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "edgy",
    "main": "./src/worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "send_metrics": false,
    "preview_urls": true,
    "dev": {
        "host": "127.0.0.1",
        "port": 3000
    },
    // "routes": [
    //     {
    //         "pattern": "example.com",
    //         "custom_domain": true
    //     }
    // ],
    "placement": {
        "mode": "smart"
    },
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "edgy",
            "database_id": "22fd37a3-771d-4ff4-8d9a-7ed0aed1d122"
        }
    ],
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
        }
    ],
    "vars": {
        "CACHE_STORE": "cloudflare",
        "DATABASE_AUTO_MIGRATE": "true",
        "LOG_FORMAT": "json",
        "NODE_VERSION": "24.22.0",
        "OTEL_SDK_DISABLED": "true",
        "PNPM_VERSION": "12.11.2",
        "RATE_LIMIT_ENABLED": "true",
        "RATE_LIMIT_MAX": "100",
        "RATE_LIMIT_STORE": "cloudflare",
        "RATE_LIMIT_WINDOW": "60000",
        "TRUSTED_PLATFORM": "CF-Connecting-IP"
    },
    "previews": {
        "d1_databases": [
            {
                "binding": "DB",
                "database_name": "edgy",
                "database_id": "22fd37a3-771d-4ff4-8d9a-7ed0aed1d122"
            }
        ],
        "ratelimits": [
            {
                "name": "RATE_LIMITER",
                "namespace_id": "1001",
                "simple": { "limit": 100, "period": 60 }
            }
        ],
        "vars": {
            "CACHE_STORE": "cloudflare",
            "DATABASE_AUTO_MIGRATE": "true",
            "LOG_FORMAT": "json",
            "NODE_VERSION": "24.22.0",
            "OTEL_SDK_DISABLED": "true",
            "PNPM_VERSION": "12.11.2",
            "RATE_LIMIT_ENABLED": "true",
            "RATE_LIMIT_MAX": "100",
            "RATE_LIMIT_STORE": "cloudflare",
            "RATE_LIMIT_WINDOW": "60000",
            "TRUSTED_PLATFORM": "CF-Connecting-IP"
        }
    }
}
