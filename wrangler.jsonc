/**
 * Cloudflare Workers target. `pnpm watch:worker` runs the source locally in
 * workerd (miniflare) with a local D1 database; `pnpm preview` runs the built
 * bundle the same way; `pnpm deploy` publishes it. Application
 * settings are the same variables the Node server reads.
 *
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "edgy",
    "main": "./src/worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "send_metrics": false,
    "preview_urls": true,
    "dev": {
        "host": "127.0.0.1",
        "port": 3000
    },
    // "routes": [
    //     {
    //         "pattern": "example.com",
    //         "custom_domain": true
    //     }
    // ],
    "placement": {
        "mode": "smart"
    },
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "edgy",
            // Local development ignores the ID. Replace it with the ID printed
            // by `wrangler d1 create edgy` before the first deploy.
            "database_id": "00000000-0000-0000-0000-000000000000"
        }
    ],
    "vars": {
        // Cloudflare always sets CF-Connecting-IP, so it is safe to trust here.
        "LOG_FORMAT": "json",
        "TRUST_PROXY": "true",
        // Applies pending migrations when an isolate starts.
        // Convenient for preview; for production prefer an explicit migration step.
        "DATABASE_AUTO_MIGRATE": "true",
        // Settings -> Variables and secrets
        "NODE_VERSION": "24.22.0",
        "PNPM_VERSION": "12.11.2"
    }
}
