/**
 * Cloudflare Workers target. The Cloudflare Vite plugin (`vite.config.ts`, with `--mode worker`) reads this file:
 * `pnpm dev --mode worker` runs the source in workerd (Vite's dev server, with a local D1 database);
 * `pnpm preview --mode worker` builds and runs the artifact the same way; `pnpm run deploy` publishes it.
 * Application settings are the same variables the Node server reads.
 *
 * The plugin writes the deployable configuration to `dist/worker/wrangler.json` and points
 * Wrangler at it, so `main` below is the entry it bundles and `assets` is added for you (the
 * browser assets in `dist/worker/public`, served by Cloudflare without starting the Worker).
 * Do not declare `assets` or `no_bundle` here.
 *
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration
 *
 * Build configurations:
 * - Build command: `pnpm build --mode worker`
 * - Deploy command: `pnpm exec wrangler deploy`
 * - Non-production branch deploy command: `pnpm exec wrangler versions upload`
 *
 * Environment variables notice:
 * - OTEL_SDK_DISABLED: Off: the default endpoint is the local ClickStack, which a deployed
 *   Worker cannot reach. To export, set OTEL_EXPORTER_OTLP_ENDPOINT and
 *   OTEL_EXPORTER_OTLP_HEADERS (a secret) and remove this line.
 *
 * - TRUSTED_PLATFORM: Cloudflare always sets CF-Connecting-IP, and a Worker is reachable
 *   only through Cloudflare, so this header is the client address.
 *
 * - DATABASE_AUTO_MIGRATE: On: each isolate migrates the database as it starts, so a new D1 (local
 *   or remote) needs no separate step. This value applies to `pnpm dev --mode worker`, `pnpm preview --mode worker`
 *   and `pnpm run deploy` alike. Isolates starting at once can race on the first migration; once the
 *   schema exists, `pnpm run deploy --var DATABASE_AUTO_MIGRATE:false` stops migrating.
 *
 * - CACHE_STORE: Read cache through the Workers Cache API: per location, and not served
 *   on workers.dev (there every read reaches D1), so use a custom domain.
 *
 * Rate limiting for /api (RATE_LIMIT_STORE=cloudflare). The allowance and the
 * period (10 or 60 seconds) are fixed here. RATE_LIMIT_MAX is only reported to
 * clients as the limit, so keep it equal to `limit`; RATE_LIMIT_WINDOW only
 * feeds Retry-After, so keep it equal to `period` in ms.
 *
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "edgy",
    "main": "./src/worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "send_metrics": false,
    "preview_urls": true,
    "dev": {
        "host": "127.0.0.1",
        "port": 3000
    },
    // "routes": [
    //     {
    //         "pattern": "example.com",
    //         "custom_domain": true
    //     }
    // ],
    "placement": {
        "mode": "smart"
    },
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "edgy",
            "database_id": "22fd37a3-771d-4ff4-8d9a-7ed0aed1d122"
        }
    ],
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
        }
    ],
    "vars": {
        "CACHE_STORE": "cloudflare",
        "DATABASE_AUTO_MIGRATE": "true",
        "LOG_FORMAT": "json",
        "NODE_VERSION": "24.22.0",
        "OTEL_SDK_DISABLED": "true",
        "PNPM_VERSION": "12.11.2",
        "RATE_LIMIT_ENABLED": "true",
        "RATE_LIMIT_MAX": "100",
        "RATE_LIMIT_STORE": "cloudflare",
        "RATE_LIMIT_WINDOW": "60000",
        "TRUSTED_PLATFORM": "CF-Connecting-IP"
    },
    "previews": {
        "d1_databases": [
            {
                "binding": "DB",
                "database_name": "edgy",
                "database_id": "22fd37a3-771d-4ff4-8d9a-7ed0aed1d122"
            }
        ],
        "ratelimits": [
            {
                "name": "RATE_LIMITER",
                "namespace_id": "1001",
                "simple": { "limit": 100, "period": 60 }
            }
        ],
        "vars": {
            "CACHE_STORE": "cloudflare",
            "DATABASE_AUTO_MIGRATE": "true",
            "LOG_FORMAT": "json",
            "NODE_VERSION": "24.22.0",
            "OTEL_SDK_DISABLED": "true",
            "PNPM_VERSION": "12.11.2",
            "RATE_LIMIT_ENABLED": "true",
            "RATE_LIMIT_MAX": "100",
            "RATE_LIMIT_STORE": "cloudflare",
            "RATE_LIMIT_WINDOW": "60000",
            "TRUSTED_PLATFORM": "CF-Connecting-IP"
        }
    }
}
