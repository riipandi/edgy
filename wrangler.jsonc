/**
 * Cloudflare Workers target. `pnpm watch:worker` runs the source locally in
 * workerd (miniflare) with a local D1 database; `pnpm preview` runs the built
 * bundle the same way; `pnpm run deploy` publishes it. Application
 * settings are the same variables the Node server reads.
 *
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration
 *
 * Build configurations:
 * - Build command: `pnpm build:worker`
 * - Deploy command: `pnpm exec wrangler deploy dist/worker/index.mjs --no-bundle`
 * - Non-production branch deploy command: `pnpm exec wrangler versions upload`
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "edgy",
    "main": "./src/worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "send_metrics": false,
    "preview_urls": true,
    "dev": {
        "host": "127.0.0.1",
        "port": 3000
    },
    // "routes": [
    //     {
    //         "pattern": "example.com",
    //         "custom_domain": true
    //     }
    // ],
    "placement": {
        "mode": "smart"
    },
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "edgy",
            // Local development ignores the ID. Replace it with the ID printed
            // by `wrangler d1 create edgy` before the first deploy.
            "database_id": "22fd37a3-771d-4ff4-8d9a-7ed0aed1d122"
        }
    ],
    // Rate limiting for /api (RATE_LIMIT_STORE=cloudflare). The allowance
    // and the period (10 or 60 seconds) are fixed here. RATE_LIMIT_MAX is
    // only reported to clients as the limit, so keep it equal to `limit`;
    // RATE_LIMIT_WINDOW only feeds Retry-After, so keep it equal to `period` in ms.
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
        }
    ],
    "vars": {
        // Off: the default endpoint is the local ClickStack, which a deployed
        // Worker cannot reach. To export, set OTEL_EXPORTER_OTLP_ENDPOINT and
        // OTEL_EXPORTER_OTLP_HEADERS (a secret) and remove this line.
        "OTEL_SDK_DISABLED": "true",
        "LOG_FORMAT": "json",
        // Cloudflare always sets CF-Connecting-IP, and a Worker is reachable
        // only through Cloudflare, so this header is the client address.
        "TRUSTED_PLATFORM": "CF-Connecting-IP",
        // Off: a preview upload shares these vars, and migrating the production
        // database from one is not what a preview is for. `pnpm watch:worker`
        // and `pnpm preview` switch it on for the local database; for the first
        // remote deploy see docs/deployment.md.
        "DATABASE_AUTO_MIGRATE": "false",
        // Read cache through the Workers Cache API: per location, and not served
        // on workers.dev (there every read reaches D1), so use a custom domain.
        "CACHE_STORE": "cloudflare",
        "RATE_LIMIT_ENABLED": "true",
        "RATE_LIMIT_STORE": "cloudflare",
        "RATE_LIMIT_MAX": "100",
        "RATE_LIMIT_WINDOW": "60000",
        // Settings -> Variables and secrets
        "NODE_VERSION": "24.22.0",
        "PNPM_VERSION": "12.11.2"
    }
}
