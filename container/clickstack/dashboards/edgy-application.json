{
    "name": "Edgy Application",
    "tags": ["edgy", "application"],
    "tiles": [
        {
            "name": "Requests (last hour)",
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Traces",
                "select": [
                    {
                        "aggFn": "count"
                    }
                ]
            }
        },
        {
            "name": "Error rate",
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "percent",
                    "mantissa": 2
                },
                "alignDateRangeToGranularity": true,
                "source": "Traces",
                "select": [
                    {
                        "aggFn": "count",
                        "where": "StatusCode = 'Error'",
                        "whereLanguage": "sql"
                    }
                ]
            }
        },
        {
            "name": "Latency p95 (ms)",
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 2,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Traces",
                "select": [
                    {
                        "aggFn": "quantile",
                        "level": 0.95,
                        "valueExpression": "Duration / 1e6"
                    }
                ]
            }
        },
        {
            "name": "Log lines (last hour)",
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Logs",
                "select": [
                    {
                        "aggFn": "count"
                    }
                ]
            }
        },
        {
            "name": "Requests over time",
            "x": 0,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Traces",
                "select": [
                    {
                        "aggFn": "count"
                    }
                ]
            }
        },
        {
            "name": "Latency percentiles (ms)",
            "x": 12,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 2,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Traces",
                "select": [
                    {
                        "aggFn": "quantile",
                        "level": 0.5,
                        "valueExpression": "Duration / 1e6",
                        "alias": "p50"
                    },
                    {
                        "aggFn": "quantile",
                        "level": 0.95,
                        "valueExpression": "Duration / 1e6",
                        "alias": "p95"
                    },
                    {
                        "aggFn": "quantile",
                        "level": 0.99,
                        "valueExpression": "Duration / 1e6",
                        "alias": "p99"
                    }
                ]
            }
        },
        {
            "name": "Error spans over time",
            "x": 0,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "stacked_bar",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Traces",
                "select": [
                    {
                        "aggFn": "count",
                        "where": "StatusCode = 'Error'",
                        "whereLanguage": "sql"
                    }
                ]
            }
        },
        {
            "name": "http_requests by status (metric)",
            "x": 12,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "stacked_bar",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "groupBy": "Attributes['status']",
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "sum",
                        "valueExpression": "Value",
                        "metricType": "sum",
                        "metricName": "http_requests",
                        "where": "MetricName = 'http_requests'",
                        "whereLanguage": "sql"
                    }
                ]
            }
        },
        {
            "name": "Requests by route",
            "x": 0,
            "y": 18,
            "w": 12,
            "h": 8,
            "config": {
                "displayType": "table",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "groupBy": "SpanName",
                "source": "Traces",
                "select": [
                    {
                        "aggFn": "count"
                    }
                ]
            }
        },
        {
            "name": "Recent error logs",
            "x": 12,
            "y": 18,
            "w": 12,
            "h": 8,
            "config": {
                "displayType": "search",
                "alignDateRangeToGranularity": true,
                "source": "Logs",
                "select": "",
                "where": "SeverityText IN ('error', 'ERROR', 'fatal', 'FATAL')",
                "whereLanguage": "sql"
            }
        }
    ]
}
