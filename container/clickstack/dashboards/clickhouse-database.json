{
    "name": "ClickHouse Database",
    "tags": ["edgy", "infra", "clickhouse"],
    "tiles": [
        {
            "name": "On-disk size",
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT sum(bytes_on_disk) AS bytes FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_%'"
            }
        },
        {
            "name": "Rows stored",
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT sum(rows) AS rows FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_%'"
            }
        },
        {
            "name": "Active parts",
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT count() AS parts FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_%'"
            }
        },
        {
            "name": "Query p95 (ms)",
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 1,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT if(count() = 0, 0, round(quantile(0.95)(query_duration_ms), 1)) AS p95_ms FROM system.query_log WHERE type = 'QueryFinish' AND is_initial_query AND $__timeFilter(event_time)"
            }
        },
        {
            "name": "Rows written per minute",
            "x": 0,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(event_time) AS ts, sum(written_rows) AS rows, count() AS inserts FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Insert' AND $__timeFilter(event_time) GROUP BY ts ORDER BY ts"
            }
        },
        {
            "name": "Query latency percentiles (ms)",
            "x": 12,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 1,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(event_time) AS ts, round(quantile(0.5)(query_duration_ms), 1) AS p50, round(quantile(0.95)(query_duration_ms), 1) AS p95, round(quantile(0.99)(query_duration_ms), 1) AS p99 FROM system.query_log WHERE type = 'QueryFinish' AND is_initial_query AND $__timeFilter(event_time) GROUP BY ts ORDER BY ts"
            }
        },
        {
            "name": "Size per table",
            "x": 0,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "table",
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT table AS table_name, formatReadableQuantity(sum(rows)) AS rows, formatReadableSize(sum(bytes_on_disk)) AS on_disk, round(sum(data_compressed_bytes) / greatest(sum(data_uncompressed_bytes), 1), 3) AS ratio FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_%' GROUP BY table ORDER BY sum(bytes_on_disk) DESC"
            }
        },
        {
            "name": "Retention (TTL) per table",
            "x": 12,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "table",
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT table AS table_name, extract(engine_full, 'TTL ([^ ]+(?: [^ ]+){0,3})') AS ttl FROM system.tables WHERE database = 'default' AND table LIKE 'otel_%' AND engine_full LIKE '%TTL%' ORDER BY table"
            }
        },
        {
            "name": "Parts and merges",
            "x": 0,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "table",
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT table AS table_name, count() AS active_parts, formatReadableSize(sum(bytes_on_disk)) AS on_disk, max(modification_time) AS newest_part FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_%' GROUP BY table ORDER BY active_parts DESC"
            }
        },
        {
            "name": "Slowest queries",
            "x": 12,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "table",
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT event_time, round(query_duration_ms, 1) AS duration_ms, formatReadableSize(memory_usage) AS memory, substring(query, 1, 120) AS query FROM system.query_log WHERE type = 'QueryFinish' AND is_initial_query AND $__timeFilter(event_time) ORDER BY query_duration_ms DESC LIMIT 25"
            }
        },
        {
            "name": "Disk free",
            "x": 0,
            "y": 25,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT sum(free_space) AS free_bytes FROM system.disks"
            }
        },
        {
            "name": "Disk total",
            "x": 6,
            "y": 25,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT sum(total_space) AS total_bytes FROM system.disks"
            }
        },
        {
            "name": "Disk used (%)",
            "x": 12,
            "y": 25,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 1
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT round(100 * (sum(total_space) - sum(free_space)) / greatest(sum(total_space), 1), 1) AS used_pct FROM system.disks"
            }
        },
        {
            "name": "Days of headroom",
            "x": 0,
            "y": 48,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT round(space.free_space / greatest(qlog.rate, 1) / 86400, 0) AS days_headroom FROM system.disks AS space CROSS JOIN (SELECT sum(written_bytes) / greatest(dateDiff('second', min(event_time), max(event_time)), 1) AS rate FROM system.query_log WHERE event_time >= now() - INTERVAL 7 DAY AND type = 'QueryFinish') AS qlog"
            }
        },
        {
            "name": "Merges in flight",
            "x": 18,
            "y": 25,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT count() AS merges FROM system.merges"
            }
        },
        {
            "name": "Application data",
            "x": 0,
            "y": 29,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT sum(bytes_on_disk) AS bytes FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_%' AND table NOT LIKE 'otel_metrics_%'"
            }
        },
        {
            "name": "Infrastructure data",
            "x": 6,
            "y": 29,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT sum(bytes_on_disk) AS bytes FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_metrics_%'"
            }
        },
        {
            "name": "Storage by signal family",
            "x": 12,
            "y": 29,
            "w": 12,
            "h": 8,
            "config": {
                "displayType": "table",
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT if(table LIKE 'otel_metrics_%', 'infra', 'app') AS family, table AS table_name, formatReadableQuantity(sum(rows)) AS rows, formatReadableSize(sum(bytes_on_disk)) AS on_disk FROM system.parts WHERE active AND database = 'default' AND table LIKE 'otel_%' GROUP BY family, table_name ORDER BY sum(bytes_on_disk) DESC"
            }
        },
        {
            "name": "Writes per minute: app vs infra",
            "x": 0,
            "y": 33,
            "w": 12,
            "h": 8,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(event_time) AS ts, if(tables[1] LIKE 'default.otel_metrics_%', 'infra', 'app') AS family, sum(written_rows) AS rows FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Insert' AND $__timeFilter(event_time) GROUP BY ts, family ORDER BY ts"
            }
        },
        {
            "name": "Application rows written per hour",
            "x": 0,
            "y": 41,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 0,
                    "thousandSeparated": true
                },
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(event_time) AS ts, sum(written_rows) AS rows FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Insert' AND tables[1] NOT LIKE 'default.otel_metrics_%' AND $__timeFilter(event_time) GROUP BY ts ORDER BY ts"
            }
        },
        {
            "name": "Application footprint by service",
            "x": 12,
            "y": 41,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "table",
                "configType": "sql",
                "source": "Logs",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT ServiceName AS service, count() AS rows, round(count() / greatest((SELECT count() FROM default.otel_traces), 1) * (SELECT sum(bytes_on_disk) FROM system.parts WHERE active AND database = 'default' AND table = 'otel_traces') / 1024 / 1024, 2) AS est_mb FROM default.otel_traces WHERE $__timeFilter(Timestamp) GROUP BY service ORDER BY est_mb DESC LIMIT 20"
            }
        }
    ]
}
