{
    "name": "Node.js Runtime Metrics",
    "tags": ["edgy", "runtime", "nodejs"],
    "filters": [
        {
            "name": "Service",
            "type": "QUERY_EXPRESSION",
            "expression": "ServiceName",
            "source": "Metrics",
            "sourceMetricType": "gauge",
            "where": "ResourceAttributes.telemetry.sdk.language:\"nodejs\"",
            "whereLanguage": "lucene"
        }
    ],
    "tiles": [
        {
            "name": "Event loop delay p99 (ms)",
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "number", "mantissa": 1, "thousandSeparated": true },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p99"
                    }
                ]
            }
        },
        {
            "name": "Event loop utilization (%)",
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "percent", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.utilization"
                    }
                ]
            }
        },
        {
            "name": "Heap used",
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.used"
                    }
                ]
            }
        },
        {
            "name": "CPU utilization (%)",
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "percent", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "process.cpu.utilization"
                    }
                ]
            }
        },
        {
            "name": "Event loop delay percentiles (ms)",
            "x": 0,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "number", "mantissa": 1, "thousandSeparated": true },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p50",
                        "alias": "p50"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p90",
                        "alias": "p90"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p99",
                        "alias": "p99"
                    }
                ]
            }
        },
        {
            "name": "Event loop utilization over time (%)",
            "x": 12,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "percent", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.utilization"
                    }
                ]
            }
        },
        {
            "name": "V8 heap: used vs limit",
            "x": 0,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.used",
                        "alias": "used"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.limit",
                        "alias": "limit"
                    }
                ]
            }
        },
        {
            "name": "V8 heap spaces (physical size)",
            "x": 12,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.space.physical_size"
                    }
                ]
            }
        },
        {
            "name": "CPU utilization over time (%)",
            "x": 0,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "percent", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "process.cpu.utilization"
                    }
                ]
            }
        },
        {
            "name": "Event loop busy time (s/min)",
            "x": 12,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "number", "mantissa": 2, "thousandSeparated": true },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "sum",
                        "valueExpression": "Value",
                        "metricType": "sum",
                        "metricName": "nodejs.eventloop.time"
                    }
                ]
            }
        }
    ]
}
