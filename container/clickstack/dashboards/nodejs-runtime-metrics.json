{
    "name": "Node.js Runtime Metrics",
    "tags": ["edgy", "runtime", "nodejs"],
    "filters": [
        {
            "name": "Service",
            "type": "QUERY_EXPRESSION",
            "expression": "ServiceName",
            "source": "Metrics",
            "sourceMetricType": "gauge",
            "where": "ResourceAttributes.telemetry.sdk.language:\"nodejs\"",
            "whereLanguage": "lucene"
        }
    ],
    "tiles": [
        {
            "name": "Event loop delay p99 (ms)",
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "number", "mantissa": 1, "thousandSeparated": true },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p99"
                    }
                ]
            }
        },
        {
            "name": "Event loop utilization (%)",
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "percent", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.utilization"
                    }
                ]
            }
        },
        {
            "name": "Heap used",
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.used"
                    }
                ]
            }
        },
        {
            "name": "Resident set size",
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "process.memory.rss"
                    }
                ]
            }
        },
        {
            "name": "Event loop delay percentiles (ms)",
            "x": 0,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "number", "mantissa": 1, "thousandSeparated": true },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p50",
                        "alias": "p50"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p90",
                        "alias": "p90"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p99",
                        "alias": "p99"
                    }
                ]
            }
        },
        {
            "name": "Event loop utilization over time (%)",
            "x": 12,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "percent", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.utilization"
                    }
                ]
            }
        },
        {
            "name": "V8 heap: used vs size limit",
            "x": 0,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.used",
                        "alias": "used"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.limit",
                        "alias": "size limit"
                    }
                ]
            }
        },
        {
            "name": "V8 heap by space",
            "x": 12,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "groupBy": "Attributes['space']",
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.space.physical_size"
                    }
                ]
            }
        },
        {
            "name": "Garbage collection time (s)",
            "x": 0,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "number", "mantissa": 3 },
                "configType": "sql",
                "source": "Metrics",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, Attributes['kind'] AS kind, round(max(Value) - min(Value), 4) AS seconds FROM $__sourceTable(sum) WHERE $__timeFilter(TimeUnix) AND MetricName = 'v8js.gc.duration' GROUP BY ts, kind ORDER BY ts"
            }
        },
        {
            "name": "CPU utilization over time (%)",
            "x": 12,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "percent", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "process.cpu.utilization"
                    }
                ]
            }
        },
        {
            "name": "Event loop busy time (s per interval)",
            "x": 0,
            "y": 25,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "number", "mantissa": 2, "thousandSeparated": true },
                "configType": "sql",
                "source": "Metrics",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, round(max(Value) - min(Value), 3) AS seconds FROM $__sourceTable(sum) WHERE $__timeFilter(TimeUnix) AND MetricName = 'nodejs.eventloop.time' GROUP BY ts ORDER BY ts"
            }
        },
        {
            "name": "Memory outside the heap",
            "x": 12,
            "y": 25,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "process.memory.external"
                    }
                ]
            }
        },
        {
            "name": "Process uptime",
            "x": 0,
            "y": 32,
            "w": 12,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "number", "mantissa": 0, "thousandSeparated": true },
                "configType": "sql",
                "source": "Metrics",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT round(if(count() = 0, 0, max(Value))) AS seconds FROM $__sourceTable(gauge) WHERE $__timeFilter(TimeUnix) AND MetricName = 'process.uptime'"
            }
        },
        {
            "name": "Heap pressure (used / size limit, %)",
            "x": 12,
            "y": 32,
            "w": 12,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "number", "mantissa": 1 },
                "configType": "sql",
                "source": "Metrics",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT round(100 * maxIf(Value, MetricName = 'v8js.memory.heap.used') / greatest(maxIf(Value, MetricName = 'v8js.memory.heap.limit'), 1), 1) AS used_pct FROM $__sourceTable(gauge) WHERE $__timeFilter(TimeUnix) AND MetricName IN ('v8js.memory.heap.used', 'v8js.memory.heap.limit')"
            }
        },
        {
            "name": "Container memory vs limit (bytes)",
            "x": 0,
            "y": 36,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "byte", "mantissa": 1 },
                "alignDateRangeToGranularity": true,
                "configType": "sql",
                "source": "Metrics",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, maxIf(Value, MetricName = 'container_memory_working_set_bytes') AS working_set, maxIf(Value, MetricName = 'container_spec_memory_limit_bytes') AS mem_limit FROM $__sourceTable(gauge) WHERE $__timeFilter(TimeUnix) AND ServiceName = 'cadvisor' AND Attributes['container_label_com_docker_compose_service'] = 'app' GROUP BY ts ORDER BY ts"
            }
        },
        {
            "name": "CPU throttled seconds (per interval)",
            "x": 12,
            "y": 36,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": { "output": "number", "mantissa": 3 },
                "alignDateRangeToGranularity": true,
                "configType": "sql",
                "source": "Metrics",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, round(max(Value) - min(Value), 3) AS seconds FROM $__sourceTable(sum) WHERE $__timeFilter(TimeUnix) AND ServiceName = 'cadvisor' AND MetricName = 'container_cpu_cfs_throttled_seconds_total' AND Attributes['container_label_com_docker_compose_service'] = 'app' GROUP BY ts ORDER BY ts"
            }
        },
        {
            "name": "Restarts observed",
            "x": 0,
            "y": 43,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": { "output": "number", "mantissa": 0, "thousandSeparated": true },
                "configType": "sql",
                "source": "Metrics",
                "connection": "Local ClickHouse",
                "sqlTemplate": "SELECT uniqExact(toInt64(Value)) AS restarts FROM $__sourceTable(gauge) WHERE $__timeFilter(TimeUnix) AND ServiceName = 'cadvisor' AND MetricName = 'container_start_time_seconds' AND Attributes['container_label_com_docker_compose_service'] = 'app'"
            }
        }
    ]
}
