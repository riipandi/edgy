{
    "name": "Node.js Runtime Metrics",
    "tags": ["otel", "runtime-metrics", "nodejs"],
    "tiles": [
        {
            "name": "EL Delay p99 (ms)",
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 1,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.delay.p99"
                    }
                ]
            }
        },
        {
            "name": "Event Loop Util",
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "percent",
                    "mantissa": 1
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.utilization"
                    }
                ]
            }
        },
        {
            "name": "Heap Used",
            "x": 12,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.used"
                    }
                ]
            }
        },
        {
            "name": "CPU Utilization",
            "x": 18,
            "y": 0,
            "w": 6,
            "h": 4,
            "config": {
                "displayType": "number",
                "numberFormat": {
                    "output": "percent",
                    "mantissa": 1
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "process.cpu.utilization"
                    }
                ]
            }
        },
        {
            "name": "Event Loop Delay Percentiles (ms)",
            "x": 0,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "number",
                    "mantissa": 1,
                    "thousandSeparated": true
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "alias": "p50",
                        "metricName": "nodejs.eventloop.delay.p50"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "alias": "p90",
                        "metricName": "nodejs.eventloop.delay.p90"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "alias": "p99",
                        "metricName": "nodejs.eventloop.delay.p99"
                    }
                ]
            }
        },
        {
            "name": "Event Loop Utilization",
            "x": 12,
            "y": 4,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "percent",
                    "mantissa": 1
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "nodejs.eventloop.utilization"
                    }
                ]
            }
        },
        {
            "name": "V8 Heap: Used vs Limit",
            "x": 0,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "alias": "used",
                        "metricName": "v8js.memory.heap.used"
                    },
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "alias": "limit",
                        "metricName": "v8js.memory.heap.limit"
                    }
                ]
            }
        },
        {
            "name": "V8 Heap Spaces (physical size)",
            "x": 12,
            "y": 11,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "byte",
                    "mantissa": 1
                },
                "alignDateRangeToGranularity": true,
                "groupBy": "",
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "v8js.memory.heap.space.physical_size"
                    }
                ]
            }
        },
        {
            "name": "CPU Utilization over time",
            "x": 0,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "numberFormat": {
                    "output": "percent",
                    "mantissa": 1
                },
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "avg",
                        "valueExpression": "Value",
                        "metricType": "gauge",
                        "metricName": "process.cpu.utilization"
                    }
                ]
            }
        },
        {
            "name": "Event Loop Busy Time",
            "x": 12,
            "y": 18,
            "w": 12,
            "h": 7,
            "config": {
                "displayType": "line",
                "alignDateRangeToGranularity": true,
                "source": "Metrics",
                "select": [
                    {
                        "aggFn": "sum",
                        "valueExpression": "Value",
                        "metricType": "sum",
                        "metricName": "nodejs.eventloop.time"
                    }
                ]
            }
        }
    ],
    "filters": [
        {
            "id": "svc-filter-001",
            "name": "ServiceName",
            "type": "QUERY_EXPRESSION",
            "expression": "ServiceName",
            "where": "ResourceAttributes.telemetry.sdk.language:\"nodejs\"",
            "whereLanguage": "lucene",
            "source": "Metrics",
            "sourceMetricType": "gauge"
        }
    ]
}
